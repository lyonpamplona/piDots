# ==============================================================================
# piDots // Configurações de Ambiente (Edge Optimized para Raspberry Pi 4B)
# ==============================================================================

# Provedor de IA (Qualquer endpoint compatível com OpenAI SDK / API)
# Exemplos:
# - OpenAI Oficial: https://api.openai.com/v1
# - OpenRouter:     https://openrouter.ai/api/v1
# - Groq:           https://api.groq.com/openai/v1
# - DeepSeek:       https://api.deepseek.com/v1
# - Local llama:    http://127.0.0.1:8080/v1
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sua_chave_aqui
AI_MODEL=gpt-4o-mini
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=60.0

# Provedor de IA Secundario (Failover Opcional & Circuit Breaker)
# Desativado por padrao. Se configurado, assume quando o primario falhar por 5xx/timeout.
# AI_FALLBACK_URL=https://openrouter.ai/api/v1
# AI_FALLBACK_API_KEY=sua_chave_secundaria_aqui
# AI_FALLBACK_MODEL=gpt-4o-mini
# AI_CIRCUIT_BREAKER_CONSECUTIVE_FAILURES=3
# AI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60.0

# Infraestrutura & Servidor
HOST=0.0.0.0
PORT=8000
DEBUG=false
ENABLE_LEGACY_REDIRECTS=true

# Desacoplamento de Portas Edge (Cloudflare Tunnel & LAN)
PORT_LANDING=8081
PORT_APP=8082
PORT_DOCS=8083
PORT_GATEWAY=8088

# Armazenamento & SQLite WAL
SQLITE_DB_PATH=./data/pidots.db
WORKSPACES_ROOT=./workspaces

# Limites Edge & Governanca (Protecao Raspberry Pi 4B)
STRICT_SANDBOX=false
MAX_ITERATIONS_PER_GOAL=8
ENABLE_THERMAL_THROTTLE=true
THERMAL_LIMIT_CELSIUS=78.0

# Seguranca Criptografica HITL (Assinatura HMAC-SHA256)
HITL_HMAC_SECRET=

# Notificações e Webhooks HITL
WEBHOOK_NOTIFICATION_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gateway de Mensageria & WhatsApp (Evolution API)
EVOLUTION_API_URL=http://host.docker.internal:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=pidots

# Sensores e Hardware de Borda (Opcional - Raspberry Pi GPIO e MQTT)
GPIO_ENABLED=false
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

