# ==============================================================================
# piDots // Configurações de Ambiente (Edge Optimized para Raspberry Pi 4B)
# ==============================================================================

# Provedor de IA (Qualquer endpoint compatível com OpenAI SDK / API)
# Exemplos:
# - Verboo:      https://api.verboo.ai/v1
# - OpenAI:      https://api.openai.com/v1
# - OpenRouter:  https://openrouter.ai/api/v1
# - Groq:        https://api.groq.com/openai/v1
# - DeepSeek:    https://api.deepseek.com/v1
# - Local llama: http://127.0.0.1:8080/v1
AI_BASE_URL=https://api.verboo.ai/v1
AI_API_KEY=sua_chave_aqui
AI_MODEL=qwen3.8-27b
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=60.0

# Infraestrutura & Servidor
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Armazenamento & SQLite WAL
SQLITE_DB_PATH=/mnt/storage/piDots/data/pidots.db
WORKSPACES_ROOT=/mnt/storage/piDots/workspaces

# Limites Edge (Proteção Raspberry Pi 4B)
MAX_ITERATIONS_PER_GOAL=8
ENABLE_THERMAL_THROTTLE=true
THERMAL_LIMIT_CELSIUS=72.0
